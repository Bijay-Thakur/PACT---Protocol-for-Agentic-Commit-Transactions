# Copy to .env and adjust. Never commit real secrets.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=pact
POSTGRES_PASSWORD=pact

# --- PACT backend ---
PACT_DATABASE_URL=postgresql+asyncpg://pact:pact@localhost:5432/pact
# "inprocess" runs the simulated providers inside the backend process (dev);
# any http(s) URL targets a separately running simulator service.
PACT_SIM_BASE_URL=inprocess
# Optional separate database for the simulated providers (defaults to PACT_DATABASE_URL).
PACT_SIM_DATABASE_URL=
PACT_ADAPTER_TIMEOUT_S=1.0
PACT_AUTO_RECOVER_ON_STARTUP=true
PACT_EMBEDDED_WORKER=true
PACT_WORKER_LEASE_S=15
PACT_APPROVAL_TTL_MINUTES=30
# Enables the opt-in simulated demo routes (still requires an operator account).
PACT_DEMO_MODE=false
PACT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PACT_LOG_LEVEL=INFO
# none | console | otlp (otlp needs opentelemetry-exporter-otlp installed)
PACT_OTEL_EXPORTER=none
# --- Restricted intent proposal (no model authority) ---
# Switch this single selector to nebius_nemotron after privately supplying its key.
# Use deterministic_fixture only for explicitly labeled offline testing.
PACT_MODEL_PROFILE=groq_dev
PACT_GROQ_BASE_URL=https://api.groq.com/openai/v1
PACT_GROQ_MODEL=openai/gpt-oss-20b
PACT_NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
PACT_NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
PACT_NEBIUS_RESPONSE_FORMAT=json_schema
PACT_MODEL_MAX_INPUT_CHARS=8000
PACT_MODEL_MAX_OUTPUT_TOKENS=600
PACT_MODEL_MAX_REQUESTS_PER_HOUR=60
PACT_MODEL_MAX_RESERVED_TOKENS_PER_HOUR=200000
PACT_MODEL_MAX_INFLIGHT=2
# Legacy PACT_PLANNER_* settings remain accepted when PACT_MODEL_PROFILE is unset.
# Do not set incompatible legacy and profile values together.
# GROQ_API_KEY=
# NEBIUS_API_KEY=
# Explicit opt-in: sends workflow descriptions, field names and action slots
# to the configured external model provider (no credentials or customer records).
PACT_PLANNER_SHARE_WORKFLOW_CATALOG=false
# For a separate MCP stdio process only; use one agent key per process.
# PACT_MCP_API_KEY=

# Optional disposable bare-Git reference harness. The configured repository
# and its dedicated pact-sandbox ref must be disposable; paths are allowlisted.
# PACT_CODE_SANDBOX_REPO=D:/path/to/disposable/sandbox.git
# PACT_CODE_SANDBOX_REPO_ID=council_fixture
# PACT_CODE_SANDBOX_ALLOWED_PATHS=approved.txt,docs/note.txt

# --- Tests ---
# Integration tests DROP and recreate this database's public schema.
PACT_TEST_DATABASE_URL=postgresql+asyncpg://pact:pact@localhost:5432/pact_test

# --- Frontend ---
NEXT_PUBLIC_PACT_API_URL=http://localhost:8000
